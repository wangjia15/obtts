{
  "name": "obtts",
  "version": "0.1.0",
  "description": "Obsidian plugin: read Markdown aloud with free neural voices (Edge TTS), sentence highlighting and auto language detection.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs --production",
    "test:engine": "node esbuild.config.mjs --engine-test"
  },
  "keywords": [
    "obsidian",
    "tts",
    "edge-tts",
    "markdown",
    "read-aloud"
  ],
  "license": "MIT",
  "dependencies": {
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-rehype": "^11.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unist-util-visit": "^5.0.0",
    "eld": "^2.0.3",
    "ws": "^8.18.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "obsidian": "latest",
    "@types/node": "^20.17.12",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3",
    "esbuild": "^0.24.2",
    "builtin-modules": "^4.0.0"
  }
}
